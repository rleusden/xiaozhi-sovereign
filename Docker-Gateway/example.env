# Resolved on the x86-64 DS218+ on 2026-09-25.
# The first digest came from the -dev image; the second from the runtime image.
DHI_PYTHON_BUILD_IMAGE=dhi.io/python:3.13-alpine3.23-dev@sha256:96af06a88f92b774394c25aa0b7f758b25495af7e53f28e0e433f35bafd6f5da
DHI_PYTHON_RUNTIME_IMAGE=dhi.io/python:3.13-alpine3.23@sha256:193755a5668ba0a0cf75e3c295ac706c0b0d50e2d585e9a0fa9a65da406e65ee

PUBLIC_WS_URL=wss://<yourhost>.synology.me:8443/xiaozhi/ws
# Where the device reaches /compute/status and /compute/wake. Empty means
# https://<host of PUBLIC_WS_URL>, the bootstrap address.
PUBLIC_COMPUTE_URL=
# Conversation backend: openai, mistral or local. BACKEND is an older alias.
AI_BACKEND=openai
OPENAI_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE=marin

# Used when AI_BACKEND=mistral.
MISTRAL_MODEL=mistral-small-latest
MISTRAL_STT_MODEL=voxtral-mini-latest
MISTRAL_TTS_MODEL=voxtral-mini-tts-2603
MISTRAL_VOICE_ID=
MISTRAL_LANGUAGE=nl
MISTRAL_TTS_GAIN=1.0
MISTRAL_MAX_SENTENCES=3
MISTRAL_TELL_DATE=

# Used when AI_BACKEND=local: speech-to-text, Ollama and text-to-speech on a
# local compute node. Replace the addresses with those of your own node.
OLLAMA_BASE_URL=http://192.168.1.24:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60
LOCAL_STT_BASE_URL=http://192.168.1.24:11500
LOCAL_STT_TIMEOUT_SECONDS=30
LOCAL_TTS_BASE_URL=http://192.168.1.24:11501
LOCAL_TTS_TIMEOUT_SECONDS=30

VAD_THRESHOLD=300
VAD_SILENCE_MS=800
TIMEZONE_OFFSET_MINUTES=120

# Leave empty for the first connection. Enter the exact Device-Id afterwards.
XIAOZHI_ALLOWED_DEVICE_ID=
LOG_LEVEL=INFO
