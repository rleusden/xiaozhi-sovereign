DHI_PYTHON_BUILD_IMAGE=dhi.io/python:3.13-alpine3.23-dev@sha256:96af06a88f92b774394c25aa0b7f758b25495af7e53f28e0e433f35bafd6f5da
DHI_PYTHON_RUNTIME_IMAGE=dhi.io/python:3.13-alpine3.23@sha256:193755a5668ba0a0cf75e3c295ac706c0b0d50e2d585e9a0fa9a65da406e65ee

PUBLIC_WS_URL=wss://<yourhost>.synology.me:8443/xiaozhi/ws
AI_BACKEND=openai
OPENAI_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_VOICE=marin

# Used when AI_BACKEND=mistral. Leave MISTRAL_VOICE_ID empty to use the first
# preset voice for MISTRAL_LANGUAGE.
MISTRAL_MODEL=mistral-small-latest
MISTRAL_VOICE_ID=
MISTRAL_LANGUAGE=nl
VAD_THRESHOLD=300
VAD_SILENCE_MS=800
TIMEZONE_OFFSET_MINUTES=120

# Leave empty for the first connection. Enter the exact Device-Id afterwards.
XIAOZHI_ALLOWED_DEVICE_ID=
LOG_LEVEL=INFO
